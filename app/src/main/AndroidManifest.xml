<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- INTERNET / ACCESS_NETWORK_STATE 由 :base 库清单合并提供，此处无需重复声明。 -->
    <application
        android:name=".AppApplication"
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AndroidBase">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".feature.settings.SettingActivity"
            android:exported="false"
            android:launchMode="standard" />

        <activity
            android:name=".feature.webview.WebViewActivity"
            android:exported="false"
            android:launchMode="standard"
            android:theme="@style/Theme.AndroidBase.WebViewDialog"
            android:windowSoftInputMode="adjustResize" />
    </application>
</manifest>
