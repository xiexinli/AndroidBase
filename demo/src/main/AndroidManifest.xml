<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- INTERNET / ACCESS_NETWORK_STATE 由 :base 库清单合并提供，此处无需重复声明。 -->
    <application
        android:name=".DemoApplication"
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Demo">
        <!-- 折叠屏自适应示例。 -->
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Compose 主要 Composable 用法示例，自身就是入口，带独立图标方便单独打开。 -->
        <activity
            android:name=".composables.ComposablesActivity"
            android:exported="true"
            android:label="Compose 用法示例" />

        <!-- 分页列表示例：下拉刷新 / 上拉加载更多 / 1~3 列布局。入口在「Compose 用法示例」页的目录里。 -->
        <activity android:name=".list.ListActivity" android:exported="false" />

    </application>
</manifest>
