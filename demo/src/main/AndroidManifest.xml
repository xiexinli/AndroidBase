<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- INTERNET / ACCESS_NETWORK_STATE 由 :base 库清单合并提供，此处无需重复声明。 -->
    <application
        android:name=".DemoApplication"
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Demo">
        <!-- Demo 示例导航首页。 -->
        <activity android:name=".ui.main.MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 自适应布局示例，由首页入口打开。 -->
        <activity android:name=".ui.adaptive.AdaptiveActivity" android:exported="false" />

        <!-- Compose 与列表示例均由应用内目录打开。 -->
        <activity android:name=".ui.composables.ComposablesActivity" android:exported="false" />
        <activity android:name=".ui.list.ListActivity" android:exported="false" />

    </application>
</manifest>
